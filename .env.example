# ==========================================================
# CYBERVAL Environment Configuration
# ==========================================================

# Database Connection (PostgreSQL)
# ----------------------------------------------------------
# Option A: Online Cloud PostgreSQL (Recommended for online access)
# Examples:
#   Neon.tech (Free Serverless Postgres):
#   DATABASE_URL=postgresql+psycopg://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
#
#   Supabase:
#   DATABASE_URL=postgresql+psycopg://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres
#
#   Render / Railway / AWS RDS / GCP Cloud SQL:
#   DATABASE_URL=postgresql+psycopg://user:password@host.cloud.com:5432/cyberval?sslmode=require
#
# Option B: Local PostgreSQL or Docker:
DATABASE_URL=postgresql+psycopg://cyberval:cyberval@localhost:5432/cyberval

# Platform Settings
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# External Intelligence Feeds (Optional)
# NVD_API_KEY=your_nvd_api_key
